# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Environment: local, staging, production
ENVIRONMENT=production

# Base
APPLICATION_NAME={{cookiecutter.application_name}}
APPLICATION_CODE={{cookiecutter.application_code}}

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:8000,https://localhost,https://localhost:8000,http://localhost.tiangolo.com"

# Database
# DATABASE_TYPE: mysql, postgres
DATABASE_TYPE=mysql
# Postgres
POSTGRES_SERVER=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Mysql
MYSQL_SERVER=
MYSQL_PORT=
MYSQL_DB=
MYSQL_USER=
MYSQL_PASSWORD=

# Logging
APPLICATION_CODE=
APPLICATION_NAME=

# Error Code
ERROR_CODE_PREFIX_AA={{cookiecutter.error_code_prefix_aa}}
ERROR_CODE_PREFIX_BB={{cookiecutter.error_code_prefix_bb}}